{# Yoga: «una práctica que reúne posturas, respiración y atención» — una pausa para respirar #}
<figure id="exp-respiracion" class="exp exp-respiracion" data-exp="respiracion">
  <div class="resp__stage">
    <span class="resp__aura" aria-hidden="true"></span>
    <span class="resp__circulo" aria-hidden="true"></span>
    <p class="resp__texto" aria-live="polite" data-resp-texto>Una pausa</p>
  </div>
  <figcaption>
    <button type="button" class="exp__btn exp__btn--play" data-resp-btn aria-pressed="false">Respirar un minuto</button>
    <p class="exp__hint">Inhalá mientras el círculo crece, exhalá mientras se recoge.</p>
  </figcaption>
</figure>
