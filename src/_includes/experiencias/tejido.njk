{# Mandalas tejidas: «un don que se transmite hilo a hilo» — el mandala se teje mientras leés #}
{%- set colores = ["#5FB0B3", "#A6CE98", "#85CFD1", "#7FCBA9", "#9CCBEB", "#F3DC8E", "#F2A29B"] %}
<figure class="exp exp-tejido" data-exp="tejido">
  <svg class="exp__svg" viewBox="0 0 200 200" aria-hidden="true">
    <g transform="rotate(45 100 100)">
      {% for r in [10, 18, 26, 34, 42, 50, 58, 66, 74] %}
      <rect class="tejido__vuelta" x="{{ 100 - r }}" y="{{ 100 - r }}" width="{{ r * 2 }}" height="{{ r * 2 }}" pathLength="1" stroke="{{ colores[loop.index0 % 7] }}" style="--i:{{ loop.index0 }}"/>
      {% endfor %}
    </g>
    <path d="M100 8v184M8 100h184" stroke="#8A6F5A" stroke-width="3" stroke-linecap="round"/>
  </svg>
  <figcaption>
    <p class="exp__caption" aria-live="polite" data-tejido-estado>Hilo a hilo</p>
    <div class="exp__progreso" aria-hidden="true"><span data-tejido-barra></span></div>
  </figcaption>
</figure>
