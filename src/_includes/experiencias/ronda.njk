{# Rondas: «La ronda es un círculo: nadie está adelante ni atrás, y cada voz se suma a las demás» #}
<figure id="exp-ronda" class="exp exp-ronda" data-exp="ronda">
  <svg class="exp__svg" viewBox="0 0 200 200" aria-hidden="true">
    <circle class="ronda__circulo" cx="100" cy="100" r="66" pathLength="1"/>
    <path class="ronda__fuego" d="M100 118c-11 0-17-7-17-15 0-7 5-11 7-16 1 4 4 5 5 6 1-6 4-10 9-13 0 9 11 12 11 22 0 9-6 16-15 16z"/>
    {% for p in geo.ronda %}
    <g class="ronda__lugar" data-ronda-lugar="{{ loop.index0 }}" transform="translate({{ p.x }} {{ p.y }})" style="--k:{{ loop.index0 }}">
      <circle class="ronda__vacio" r="9"/>
      <g class="ronda__voz"><circle r="9"/><circle class="ronda__onda" r="9"/></g>
    </g>
    {% endfor %}
  </svg>
  <figcaption>
    <p class="exp__caption" aria-live="polite" data-ronda-estado>Cada voz se suma</p>
    <div class="pasos__ctrl">
      <button type="button" class="exp__btn exp__btn--play" data-ronda-sumar>Sumá una voz</button>
      <button type="button" class="exp__link" data-ronda-reset hidden>Empezar de nuevo</button>
    </div>
  </figcaption>
</figure>
