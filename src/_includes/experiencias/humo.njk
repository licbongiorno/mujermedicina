{# Sahúmo: «el fuego, que enciende, y el aire, que lleva el humo» #}
<figure class="exp exp-humo" data-exp="humo">
  <div class="humo__stage" data-humo-stage>
    <svg class="exp__svg" viewBox="0 0 200 220" aria-hidden="true">
      <g class="humo__hilos" fill="none" stroke-linecap="round">
        <path data-humo-hilo="0" stroke="#85CFD1" stroke-width="2"/>
        <path data-humo-hilo="1" stroke="#BAE4E3" stroke-width="1.6"/>
        <path data-humo-hilo="2" stroke="#A6CE98" stroke-width="1.4"/>
      </g>
      <circle class="humo__brasa" cx="100" cy="156" r="5"/>
      <path d="M62 158h76c0 22-17 38-38 38s-38-16-38-38z" fill="#FCF6DF" stroke="#7A5D10" stroke-width="1.6"/>
      <path d="M86 196l-6 14h40l-6-14" fill="none" stroke="#7A5D10" stroke-width="1.6"/>
    </svg>
  </div>
  <figcaption>
    <p class="exp__caption">El aire lleva el humo</p>
    <p class="exp__hint">Mové el dedo o el cursor sobre el humo, como una brisa.</p>
  </figcaption>
</figure>
