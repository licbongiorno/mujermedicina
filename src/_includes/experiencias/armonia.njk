{# Armonizaciones: «Siempre estamos a tiempo de volver a la pureza de nuestro ser» — de la agitación a la calma #}
<figure id="exp-armonia" class="exp exp-armonia" data-exp="armonia">
  <svg class="exp__svg" viewBox="0 0 300 140" aria-hidden="true">
    <path class="armonia__onda" data-armonia-onda="0" fill="none" stroke="#5FB0B3" stroke-width="2" stroke-linecap="round"/>
    <path class="armonia__onda" data-armonia-onda="1" fill="none" stroke="#7FCBA9" stroke-width="1.6" stroke-linecap="round" opacity=".8"/>
    <path class="armonia__onda" data-armonia-onda="2" fill="none" stroke="#85CFD1" stroke-width="1.3" stroke-linecap="round" opacity=".6"/>
  </svg>
  <figcaption>
    <label class="armonia__control">
      <span class="exp__caption" data-armonia-estado>Agitación</span>
      <input type="range" min="0" max="100" value="0" data-armonia-rango aria-label="Aquietar las ondas">
      <span class="exp__hint">Deslizá hacia la derecha para aquietar.</span>
    </label>
  </figcaption>
</figure>
