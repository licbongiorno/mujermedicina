{# Mandala geométrica: pétalos que se abren desde el centro, vuelta a vuelta #}
<svg class="illu illu--mandala" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
  <g class="illu__giro">
    {% for a in range(0, 360, 45) %}<path class="draw" pathLength="1" d="M100 100c-10-16-10-34 0-50 10 16 10 34 0 50z" transform="rotate({{ a }} 100 100)" style="--d:{{ loop.index0 * 0.08 }}s"/>{% endfor %}
    {% for a in range(22, 382, 45) %}<path class="draw" pathLength="1" d="M100 46c-6-8-6-16 0-24 6 8 6 16 0 24z" transform="rotate({{ a }} 100 100)" opacity=".7"/>{% endfor %}
  </g>
  <circle class="draw" pathLength="1" cx="100" cy="100" r="82" opacity=".4"/>
  <circle class="draw" pathLength="1" cx="100" cy="100" r="58" stroke-dasharray="2 6" opacity=".6"/>
  <circle cx="100" cy="100" r="7" fill="#FCF6DF" stroke="#E7C65A"/>
</svg>
