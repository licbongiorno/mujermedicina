{%- set pc = categorias | categoria(p.categoria) %}
<article class="card pcard accent-{{ p.acento or 'agua' }}" data-reveal data-spot data-cat="{{ p.categoria }}">
  <div class="pcard__illu" aria-hidden="true">{% include "ilustraciones/" + p.ilustracion + ".njk" %}</div>
  <p class="eyebrow">{{ pc.nombre }}</p>
  <h3 class="pcard__title"><a class="pcard__link" href="/propuestas/{{ p.slug }}/">{{ p.titulo }}</a></h3>
  {% if p.kicker %}<p class="card__meta">{{ p.kicker }}</p>{% endif %}
  <p>{{ p.resumen }}</p>
  <span class="card__link" aria-hidden="true">Conocer <span>→</span></span>
</article>
