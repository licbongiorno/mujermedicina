{#- Datos estructurados (JSON-LD): ayudan a buscadores y asistentes de IA
    a entender quién es, qué hace y dónde. -#}
{%- set sameAs = [] %}
{%- for i in site.instagram %}{% set sameAs = (sameAs.push(i.handle | ig), sameAs) %}{% endfor %}
{%- if site.facebook.url %}{% set sameAs = (sameAs.push(site.facebook.url), sameAs) %}{% endif %}
{%- set knows = [] %}
{%- for p in propuestas %}{% set knows = (knows.push(p.titulo), knows) %}{% endfor %}
{%- set graph = [
  {
    "@type": "WebSite",
    "@id": site.url + "/#website",
    "url": site.url + "/",
    "name": site.brand + " · " + site.person,
    "description": site.description,
    "inLanguage": site.lang,
    "publisher": { "@id": site.url + "/#lucia" }
  },
  {
    "@type": "Person",
    "@id": site.url + "/#lucia",
    "name": site.person,
    "alternateName": [site.brand, site.spiritName],
    "description": site.description,
    "jobTitle": site.roles | join(", "),
    "url": site.url + "/",
    "image": site.url + "/assets/img/icon-512.png",
    "email": "mailto:" + site.email,
    "telephone": site.phoneDisplay,
    "homeLocation": { "@type": "Place", "name": site.location, "address": { "@type": "PostalAddress", "addressRegion": site.region, "addressCountry": site.country } },
    "knowsAbout": knows,
    "sameAs": sameAs
  },
  {
    "@type": "WebPage",
    "url": page.url | absoluteUrl(site.url),
    "name": title or site.brand,
    "description": description or site.description,
    "isPartOf": { "@id": site.url + "/#website" },
    "about": { "@id": site.url + "/#lucia" },
    "inLanguage": site.lang
  }
] %}
{%- if schemaExtra %}{% set graph = (graph.push(schemaExtra), graph) %}{% endif %}
{%- if page.url != "/" and not noindex %}
  {%- set crumbs = [{ "@type": "ListItem", "position": 1, "name": "Inicio", "item": site.url + "/" }] %}
  {%- for b in breadcrumbs %}{% set crumbs = (crumbs.push({ "@type": "ListItem", "position": loop.index + 1, "name": b.label, "item": b.url | absoluteUrl(site.url) }), crumbs) %}{% endfor %}
  {%- set crumbs = (crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": crumbTitle or title }), crumbs) %}
  {%- set graph = (graph.push({ "@type": "BreadcrumbList", "itemListElement": crumbs }), graph) %}
{%- endif %}
{%- if faqItems and faqItems.length %}
  {%- set qa = [] %}
  {%- for f in faqItems %}{% set qa = (qa.push({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }), qa) %}{% endfor %}
  {%- set graph = (graph.push({ "@type": "FAQPage", "mainEntity": qa }), graph) %}
{%- endif %}
{%- set evsSchema = (eventos | proximos(p.slug if p else null)) if (p or page.url == "/") else [] %}
{%- for e in evsSchema %}
  {%- set pr = propuestas | porSlug([e.propuesta]) | first %}
  {%- set virtual = ((e.modalidad or (pr.modalidad if pr) or "") | lower).indexOf("virtual") != -1 %}
  {%- set graph = (graph.push({
    "@type": "Event",
    "name": e.titulo or pr.titulo,
    "startDate": e.fecha + ("T" + e.hora if e.hora else ""),
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode" if virtual else "https://schema.org/OfflineEventAttendanceMode",
    "location": { "@type": "VirtualLocation", "url": site.url + "/propuestas/" + e.propuesta + "/" } if virtual else { "@type": "Place", "name": e.lugar or (pr.lugar if pr) or site.location, "address": { "@type": "PostalAddress", "addressRegion": site.region, "addressCountry": site.country } },
    "organizer": { "@id": site.url + "/#lucia" },
    "url": site.url + "/propuestas/" + e.propuesta + "/",
    "description": e.nota or (pr.resumen if pr)
  }), graph) %}
{%- endfor %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@graph": graph } | json | safe }}</script>
