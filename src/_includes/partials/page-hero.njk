<section class="page-hero" data-hero>
  <img class="page-hero__mandala" src="/assets/img/logo-mandala-376.webp" width="376" height="376" alt="" aria-hidden="true" data-parallax="0.12">
  <div class="container">
    {% if page.url != "/" %}{% include "partials/breadcrumbs.njk" %}{% endif %}
    {% if hero.eyebrow %}<p class="eyebrow" data-reveal>{{ hero.eyebrow }}</p>{% endif %}
    <h1 class="split" data-split>{{ (hero.title or title) | palabras | safe }}</h1>
    {% if hero.lead %}<p class="lead narrow" data-reveal data-reveal-delay="1">{{ hero.lead }}</p>{% endif %}
  </div>
</section>
