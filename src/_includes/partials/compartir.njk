{#- Compartir la página: menú nativo del celular, WhatsApp o copiar el enlace -#}
{%- set urlAbs = page.url | absoluteUrl(site.url) %}
<div class="share" data-share data-url="{{ urlAbs }}" data-title="{{ (crumbTitle or title) }}">
  <p class="share__label">Compartir</p>
  <div class="share__btns">
    <a class="share__btn" href="https://wa.me/?text={{ ((crumbTitle or title) + ' · ' + urlAbs) | urlencode }}" target="_blank" rel="noopener" aria-label="Compartir por WhatsApp">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z"/></svg>
      WhatsApp
    </a>
    <button class="share__btn" type="button" data-copy aria-label="Copiar el enlace">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
      <span data-copy-label>Copiar enlace</span>
    </button>
    <button class="share__btn" type="button" data-native-share hidden>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"/></svg>
      Más opciones
    </button>
  </div>
</div>
