<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="{{ site.brand }}, ir al inicio">
      <img class="brand__mark" src="/assets/img/logo-mandala-96.webp" width="44" height="44" alt="">
      <span class="brand__name">{{ site.brand }}</span>
    </a>
    <button class="search-toggle" type="button" data-buscador-abrir aria-label="Buscar en el sitio" hidden>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </button>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu" data-nav-toggle>
      <span class="nav-toggle__line"></span><span class="nav-toggle__line"></span>
      <span class="visually-hidden">Abrir menú</span>
    </button>
    <nav class="site-nav" id="menu" aria-label="Principal" data-nav>
      <ul class="site-nav__list">
        <li class="solo-movil"><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Inicio</a></li>
        {%- for item in navigation %}{% if not item.soloPie %}
        {%- set active = (page.url == item.url) or (item.url != "/" and page.url.startsWith(item.url)) %}
        {%- if item.menu %}
        <li class="has-mega" data-mega>
          <a href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a>
          <button class="mega-toggle" type="button" aria-expanded="false" aria-controls="mega-propuestas" data-mega-toggle>
            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 4.5 6 8l4-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span class="visually-hidden">Ver propuestas por categoría</span>
          </button>
          <div class="mega" id="mega-propuestas" data-mega-panel>
            <div class="mega__inner">
              {% for cat in categorias %}
              <div class="mega__col accent-{{ cat.acento }}">
                <p class="mega__cat">{{ cat.nombre }}</p>
                <ul>
                  {% for p in propuestas | deCategoria(cat.id) %}
                  <li><a href="/propuestas/{{ p.slug }}/"{% if page.url == '/propuestas/' + p.slug + '/' %} aria-current="page"{% endif %}><span class="mega__dot accent-{{ p.acento }}" aria-hidden="true"></span>{{ p.nombreCorto or p.titulo }}</a></li>
                  {% endfor %}
                </ul>
              </div>
              {% endfor %}
              <a class="mega__all" href="/propuestas/">Ver todas las propuestas <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </li>
        {%- else %}
        <li><a href="{{ item.url }}"{% if active %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endif %}
        {%- endif %}{% endfor %}
      </ul>
      <a class="btn btn--primary site-nav__cta" href="{{ (waMessage or site.waMessages.general) | wa(site.whatsapp) }}" target="_blank" rel="noopener">Escribime</a>
    </nav>
  </div>
</header>
