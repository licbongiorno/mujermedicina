<footer class="site-footer">
  <svg class="wave wave--top" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 48c160-30 320-44 480-30s320 50 480 52 320-30 480-46V80H0z"/></svg>
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <img src="/assets/img/logo-mandala-192.webp" width="88" height="88" alt="" loading="lazy">
      <p class="site-footer__name">{{ site.brand }}</p>
      <p>{{ site.person }} · {{ site.spiritName | replace("Mujer Medicina ", "") }}</p>
      <p class="site-footer__small">{{ site.roles | join(" · ") }}</p>
    </div>
    <nav aria-label="Pie de página" class="site-footer__navs">
      <div>
        <p class="site-footer__h">Sitio</p>
        <ul class="site-footer__nav">
          {%- for item in navigation %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endfor %}
        </ul>
      </div>
      <div>
        <p class="site-footer__h">Propuestas</p>
        <ul class="site-footer__nav">
          {%- for p in propuestas %}<li><a href="/propuestas/{{ p.slug }}/">{{ p.nombreCorto or p.titulo }}</a></li>{% endfor %}
        </ul>
      </div>
    </nav>
    <div class="site-footer__contact">
      <a class="btn btn--light" href="{{ site.waMessages.general | wa(site.whatsapp) }}" target="_blank" rel="noopener">Escribime por WhatsApp</a>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>{{ site.location }}</p>
      <ul class="social">
        {% for i in site.instagram %}<li><a href="{{ i.handle | ig }}" target="_blank" rel="noopener">@{{ i.handle }}</a></li>{% endfor %}
        {% if site.facebook.url %}<li><a href="{{ site.facebook.url }}" target="_blank" rel="noopener">Facebook</a></li>{% endif %}
      </ul>
    </div>
  </div>
  <p class="container site-footer__legal">© {{ site.year }} {{ site.person }} · {{ site.brand }}</p>
</footer>
