<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set suffix = (" · " + site.person + ", " + site.brand) if (title and title.length <= 26) else (" · " + site.person) %}
  {%- set pageTitle = (title + suffix) if (title and not (site.brand in title)) else (title or site.brand) %}
  {%- set pageDesc = description or site.description %}
  {%- set canonical = page.url | absoluteUrl(site.url) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ canonical }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <meta name="theme-color" content="#BAE4E3">

  <meta property="og:type" content="{{ 'article' if ('escrito' in (tags or [])) else 'website' }}">
  {%- if 'escrito' in (tags or []) %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:author" content="{{ site.person }}">{% endif %}
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="{{ site.brand }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ '/assets/img/og.jpg' | absoluteUrl(site.url) }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Lucía Di Mauro, Mujer Medicina: mandala en tonos verdes y celestes">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ '/assets/img/og.jpg' | absoluteUrl(site.url) }}">
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Resumen para asistentes de IA">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {#- Fuentes cargadas sin bloquear la página (el texto aparece al instante y luego toma la tipografía) #}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,50..100;1,9..144,300..600,50..100&family=Figtree:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,50..100;1,9..144,300..600,50..100&family=Figtree:wght@400;500;600&display=swap"></noscript>
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | version }}">
  {%- if labAssets %}
  <link rel="stylesheet" href="{{ '/assets/css/laboratorios.css' | version }}">{% endif %}
  <script>document.documentElement.classList.add("js")</script>

  {% include "partials/schema.njk" %}
</head>
<body class="{{ bodyClass }}{% if not site.showPending %} hide-pending{% endif %}" data-exp-src="{{ '/assets/js/experiencias.js' | version }}" data-search-src="{{ '/assets/js/buscador.js' | version }}" data-search-index="/buscar.json">
  <a class="skip-link" href="#contenido">Ir al contenido</a>
  {% include "partials/header.njk" %}
  <main id="contenido">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/whatsapp-float.njk" %}
  {% include "partials/buscador.njk" %}
  <script src="{{ '/assets/js/main.js' | version }}" defer></script>
  {%- if labAssets %}
  <script src="{{ '/assets/js/laboratorios.js' | version }}" defer></script>{% endif %}
</body>
</html>
