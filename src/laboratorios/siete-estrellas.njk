orden: 6
tipo: Constelación
interaccion: Tocar y unir
minutos: 4
acento: noche
ilustracion: estrellas
propuestasLab: ["terapia-vibracional-tameana"]
fuentes:
  - { titulo: "Tameana", url: "/propuestas/terapia-vibracional-tameana/" }
